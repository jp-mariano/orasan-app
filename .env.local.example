# 'dev' or 'production'
NODE_ENV=dev

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public URL of this app’s source repository (optional; shows "Source code" in the home footer).
# NEXT_PUBLIC_APP_REPOSITORY_URL=https://github.com/your-org/orasan-app

# App's socials (optional; shows Social links in the home footer).
# NEXT_PUBLIC_APP_X_URL=https://x.com/OrasanApp

# Legal / operator contact (shown on /privacy, /terms, /license). All optional.
# NEXT_PUBLIC_OPERATOR_LEGAL_NAME=Your Company LLC
# NEXT_PUBLIC_OPERATOR_CONTACT_EMAIL=legal@example.com
# NEXT_PUBLIC_OPERATOR_SUPPORT_URL=https://example.com/contact

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Resend Configuration
RESEND_API_KEY=your_resend_api_key

# Vercel Cron Job
CRON_SECRET=your_cron_secret

# Used server-side for checkout, portal, webhooks, and entitlement validation.
FREEMIUS_PRODUCT_ID=your_product_id
FREEMIUS_API_KEY=your_api_key
FREEMIUS_SECRET_KEY=your_secret_key
FREEMIUS_PUBLIC_KEY=your_public_key
